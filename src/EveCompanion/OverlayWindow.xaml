<Window x:Class="EveCompanion.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Companion Overlay"
        Width="280" Height="118"
        AllowsTransparency="True" Background="Transparent"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False" IsHitTestVisible="False">
    <Border Background="#D90B1020" BorderBrush="#8055D7FF" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="EVE COMPANION" Foreground="#FF55D7FF" FontWeight="Bold" />
                <TextBlock x:Name="SessionStateText" Text="IDLE" Foreground="#FF91A0BA" DockPanel.Dock="Right" />
            </DockPanel>
            <TextBlock x:Name="RateText" Text="0 ISK/ч" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock x:Name="DetailsText" Text="0 ISK  ·  0:00" Foreground="#FFC1CCDC" />
        </StackPanel>
    </Border>
</Window>
