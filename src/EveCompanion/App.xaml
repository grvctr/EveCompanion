<Application x:Class="EveCompanion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151C2F" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#29334D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#55D7FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#91A0BA" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#ECF4FF" />
            <Setter Property="Background" Value="#0B1020" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F8FF" />
            <Setter Property="Background" Value="#263451" />
            <Setter Property="BorderBrush" Value="#3C4C6D" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F8FF" />
            <Setter Property="Background" Value="#0E1528" />
            <Setter Property="BorderBrush" Value="#3C4C6D" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#E7EEF9" />
            <Setter Property="Padding" Value="7,5" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#ECF4FF" />
            <Setter Property="BorderBrush" Value="#29334D" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="#E8F0FA" />
            <Setter Property="Background" Value="#10182A" />
            <Setter Property="RowBackground" Value="#10182A" />
            <Setter Property="AlternatingRowBackground" Value="#151E33" />
            <Setter Property="BorderBrush" Value="#29334D" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#29334D" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
        </Style>
    </Application.Resources>
</Application>
